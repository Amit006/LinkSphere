# LinkSphere — Environment Variables
# Copy to .env.local (never commit actual values)

# ─── AWS ──────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# ─── DynamoDB ─────────────────────────────────────────────────────────────
DYNAMODB_TABLE_URLS=linksphere-api-urls-dev
DYNAMODB_TABLE_COUNTERS=linksphere-api-counters-dev

# ─── Redis (Upstash recommended for serverless) ────────────────────────────
# Get free instance at: https://upstash.com
REDIS_URL=redis://default:password@your-instance.upstash.io:6379

# ─── PostgreSQL (Supabase or Neon recommended) ─────────────────────────────
# Get free instance at: https://supabase.com or https://neon.tech
DATABASE_URL=postgresql://user:password@host:5432/linksphere

# ─── App ──────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Auth (add when implementing JWT) ─────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production

# ─── Local dev ────────────────────────────────────────────────────────────
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linksphere_dev
DEV_DATABASE_URL=postgresql://user:password@dev-host:5432/linksphere_dev
PROD_DATABASE_URL=postgresql://user:password@prod-host:5432/linksphere_prod

# ─── Vercel (for web deployment) ──────────────────────────────────────────
VERCEL_TOKEN=your_vercel_token
