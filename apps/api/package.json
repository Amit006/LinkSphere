{
  "name": "@linksphere/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "ts-node-dev --respawn --transpile-only src/server.local.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@linksphere/core": "*",
    "@prisma/client": "^5.15.0",
    "ioredis": "^5.4.1",
    "ua-parser-js": "^1.0.38",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.140",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "node-loader": "^2.1.0",
    "prisma": "^5.15.0",
    "serverless": "^3.38.0",
    "serverless-webpack": "^5.14.0",
    "ts-loader": "^9.5.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "webpack": "^5.92.0"
  }
}
